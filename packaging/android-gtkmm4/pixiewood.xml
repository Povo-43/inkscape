<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="sem121010">
    <xi:include href="src://data/org.inkscape.AndroidGtkmm4.metainfo.xml" parse="xml"/>
  </metainfo>
  <style>
    <theme name="gtk"/>
    <icon type="generate">
      <drawable target="foreground" scale=".5" type="svg" path="src://data/icon.svg"/>
      <color target="background">#FFFFFF</color>
    </icon>
  </style>
  <dependencies>
    <glib>
      <patch>hack</patch>
      <patch>pthread-restrictions</patch>
    </glib>
    <harfbuzz/>
    <fontconfig/>
    <cairo/>
    <gdk-pixbuf/>
    <gtk/>
  </dependencies>
  <build target="inkscape-android-gtkmm4">
    <architectures>
      <arch>aarch64</arch>
      <arch>x86_64</arch>
    </architectures>
    <configure-options>
      <option>-Dgtk:media-gstreamer=disabled</option>
      <option>-Dgtk:buildtype=debugoptimized</option>
      <option>-Dgtk:print-cups=disabled</option>
      <option>-Dgtk:build-demos=false</option>
      <option>-Dgtk:build-testsuite=false</option>
      <option>-Dgtk:build-examples=false</option>
      <option>-Dgtk:build-tests=false</option>
      <option>-Dgtk:introspection=disabled</option>

      <option>-Dsigcpp-3.0:build-examples=false</option>
      <option>-Dsigcpp-3.0:build-tests=false</option>
      <option>-Dsigcpp-3.0:build-manual=false</option>

      <option>-Dglibmm-2.68:build-examples=false</option>
      <option>-Dglibmm-2.68:build-documentation=false</option>

      <option>-Dcairomm-1.16:build-examples=false</option>
      <option>-Dcairomm-1.16:build-tests=false</option>
      <option>-Dcairomm-1.16:build-documentation=false</option>

      <option>-Dpangomm-2.48:build-documentation=false</option>

      <option>-Dgtkmm-4.0:build-demos=false</option>
      <option>-Dgtkmm-4.0:build-tests=false</option>
      <option>-Dgtkmm-4.0:build-documentation=false</option>
    </configure-options>
  </build>
</app>
